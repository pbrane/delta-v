# Delta-V l8opensim provisioner sidecar — one-shot container that POSTs
# the 20-device seed definition to an already-healthy l8opensim instance.
# Wraps curlimages/curl with the seed (devices.json + post-each.sh) baked
# in, so the compose file doesn't need a host bind mount.
FROM curlimages/curl:8.10.1

LABEL org.opencontainers.image.title="Delta-V l8opensim Provisioner" \
      org.opencontainers.image.description="POSTs the delta-v 20-device seed to l8opensim on first boot"

COPY l8opensim/ /seed/
