<?xml version="1.0" encoding="UTF-8"?>
<!--
  Foreign source for mhuot-labs Containerlab topology (cEOS devices).
  Only ICMP and SNMP detectors — no cloud service LoopDetectors or label policies.
-->
<foreign-source xmlns="http://xmlns.opennms.org/xsd/config/foreign-source" name="mhuot-labs">
    <scan-interval>1d</scan-interval>
    <detectors>
        <detector name="ICMP" class="org.opennms.netmgt.provision.detector.icmp.IcmpDetector"/>
        <detector name="SNMP" class="org.opennms.netmgt.provision.detector.snmp.SnmpDetector"/>
    </detectors>
    <policies/>
</foreign-source>
