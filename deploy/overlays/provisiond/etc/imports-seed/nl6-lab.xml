<?xml version="1.0" encoding="UTF-8"?>
<!--
  EMPTY BY DESIGN. The real nl6 device requisition (29 nodes at location=nl6-lab,
  foreign-source=nl6) lives in ../imports-seed-nl6/nl6-lab.xml and is swapped into
  the provisiond imports volume by the profile-gated `provisiond-nl6-init` sidecar
  ONLY when the nl6 stack runs (profiles: active/full/metrics/demo — the same set
  as nl6 + nl6-minion).

  On a Default-only or lean E2E stack, nl6-minion is NOT running, so importing the
  29 nl6-lab nodes would schedule polls at location=nl6-lab with no Minion to serve
  them — every poll RPC is dropped by the gateway and times out (~30s each),
  flooding pollerd's RPC client and starving other locations' down-detection.
  Keeping this empty means provisiond imports 0 nodes there.
  See issue #368 and project_provisiond_e2e_slowness_root_cause.
-->
<model-import xmlns="http://xmlns.opennms.org/xsd/config/model-import"
              foreign-source="nl6">
</model-import>
