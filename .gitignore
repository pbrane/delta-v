core/web-assets/.pnpm-debug.log
ui/.pnpm-store/
ui/.pnpm-debug.log
ui/dist/
ui/src/main/dist/
ui/src/menu/dist-menu/
ui/src/main/node_modules/
ui/src/menu/node_modules/
ui/node_modules/
ui/package-lock.json
ui/devConfig.ts
built_dependencies

# jansi downloads a native lib on osx sometimes
/maven/**/*.jnilib

# Ignore Visual Studio Code
.factorypath
# Ignore Docker/OCI temporary files
.docker_temp*
*.oci

# Python
*.pyc
__pycache__

# Antora artifacts
/build/
/public/

# Ignore jenv local version files
.java-version

# Ignore secure vault
opennms-base-assembly/src/main/filtered/etc/scv.jce

core/web-assets/.eslintcache

# Git worktrees
.worktrees/

# AI tools
.agents/
.claude/
.cursor/
.aider*
.copilot/
.gemini/
_bmad/
_bmad-output/

# Credentials & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p12
auth.json


# Superpowers brainstorming session artifacts (ephemeral)
.superpowers/

# Runtime provisiond imports directory. The committed source of truth lives
# under overlays/provisiond/etc/imports-seed/ and is copied into a Docker
# named volume on first start by the provisiond-imports-init sidecar. The
# directory itself must exist on the host (Docker cannot create a mountpoint
# under an RO bind mount), hence the .gitkeep; anything else that appears
# here is runtime drift and must not be committed.
deploy/overlays/provisiond/etc/imports/*
!deploy/overlays/provisiond/etc/imports/.gitkeep

# E2E backup files: test-collectd-e2e.sh / test-passive-e2e.sh back up the canonical
# provisiond-configuration.xml before overwriting it and restore it on EXIT (#201).
# A *.e2e-backup only lingers after an abnormal exit and must never be committed.
*.e2e-backup

# Flat poller service catalog — the single source of truth is committed at
# overlays/shared/poller-services.yaml; build.sh stages a copy into each
# consuming daemon's overlay at image-build time. Those copies are generated,
# never committed (see tools/build.sh stage_shared_poller_catalog).
deploy/overlays/pollerd/etc/poller-services.yaml
deploy/overlays/perspectivepollerd/etc/poller-services.yaml

# SNMP peer configuration — the single source of truth is committed at
# overlays/shared/etc/snmp-config.xml; build.sh stages a copy into each
# SNMP-consuming daemon's overlay at image-build time. Those copies are
# generated, never committed (see tools/build.sh stage_shared_snmp_config).
deploy/overlays/collectd/etc/snmp-config.xml
deploy/overlays/pollerd/etc/snmp-config.xml
deploy/overlays/provisiond/etc/snmp-config.xml
deploy/overlays/enlinkd/etc/snmp-config.xml
deploy/overlays/perspectivepollerd/etc/snmp-config.xml

# C4 diagram export tooling (npm deps)
docs/architecture/c4/scripts/node_modules/
# Structurizr Lite regenerable artifacts (layout cache + compiled workspace)
docs/architecture/c4/.structurizr/
docs/architecture/c4/workspace.json
