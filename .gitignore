core/web-assets/.pnpm-debug.log
ui/.pnpm-store/
ui/.pnpm-debug.log
ui/dist/
ui/src/main/dist/
ui/src/menu/dist-menu/
ui/src/main/node_modules/
ui/src/menu/node_modules/
ui/node_modules/
ui/package-lock.json
ui/devConfig.ts
built_dependencies

# jansi downloads a native lib on osx sometimes
/maven/**/*.jnilib

# Ignore Visual Studio Code
.factorypath
# Ignore Docker/OCI temporary files
.docker_temp*
*.oci

# Python
*.pyc
__pycache__

# Antora artifacts
/build/
/public/

# Ignore jenv local version files
.java-version

# Ignore secure vault
opennms-base-assembly/src/main/filtered/etc/scv.jce

core/web-assets/.eslintcache

# Git worktrees
.worktrees/

# AI tools
.agents/
.claude/
.cursor/
.aider*
.copilot/
.gemini/
_bmad/
_bmad-output/

# Credentials & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.p12
auth.json


# Superpowers brainstorming session artifacts (ephemeral)
.superpowers/

# Runtime provisiond imports directory. The committed source of truth lives
# under overlays/provisiond/etc/imports-seed/ and is copied into a Docker
# named volume on first start by the provisiond-imports-init sidecar. The
# directory itself must exist on the host (Docker cannot create a mountpoint
# under an RO bind mount), hence the .gitkeep; anything else that appears
# here is runtime drift and must not be committed.
deploy/overlays/provisiond/etc/imports/*
!deploy/overlays/provisiond/etc/imports/.gitkeep

# C4 diagram export tooling (npm deps)
docs/architecture/c4/scripts/node_modules/
# Structurizr Lite regenerable artifacts (layout cache + compiled workspace)
docs/architecture/c4/.structurizr/
docs/architecture/c4/workspace.json
